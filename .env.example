# ============================================================
#  SuperMarket — Backend (Node.js + Express + MySQL)
#  Copiar este archivo a `.env` y completar los valores.
#  NUNCA subir `.env` al repositorio.
# ============================================================

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Puerto del servidor HTTP
PORT=3000

# Conexión a MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=supermercadomarket
DB_USER=root
DB_PASSWORD=

# Autenticación (JWT)
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=1h
